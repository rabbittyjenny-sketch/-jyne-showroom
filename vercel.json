{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/community",
      "destination": "/app.html"
    },
    {
      "source": "/community/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/backoffice",
      "destination": "/admin.html"
    },
    {
      "source": "/backoffice/:path*",
      "destination": "/admin.html"
    }
  ]
}
